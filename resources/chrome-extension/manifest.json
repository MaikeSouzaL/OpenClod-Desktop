{
  "manifest_version": 3,
  "key": "",
  "name": "Openclod Desktop Bridge",
  "short_name": "Openclod",
  "version": "0.2.1",
  "description": "Permite ao Openclod usar o Chrome já aberto, organizando cada sessão em um grupo de abas, com aviso na página e botão para parar o agente.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "tabGroups", "scripting", "nativeMessaging", "storage", "alarms", "cookies", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Openclod Desktop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "stop-agent": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Parar o agente do Openclod"
    }
  },
  "minimum_chrome_version": "116"
}
