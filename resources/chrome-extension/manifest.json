{
  "manifest_version": 3,
  "key": "",
  "name": "Openclod Desktop Bridge",
  "version": "0.1.1",
  "description": "Permite ao Openclod usar o Chrome já aberto, organizando cada sessão em um grupo de abas.",
  "permissions": ["tabs", "tabGroups", "scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Openclod Desktop" },
  "minimum_chrome_version": "116"
}
