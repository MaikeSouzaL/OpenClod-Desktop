{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/lib/activity.ts",
    "src/renderer/src/lib/groups.ts",
    "src/renderer/src/lib/drawings.ts",
    "src/renderer/src/lib/speech.ts",
    "src/renderer/src/lib/connectors.ts",
    "src/renderer/src/lib/connector-icons.ts",
    "src/renderer/src/lib/connector-icon-index.ts",
    "src/renderer/src/lib/path-attachments.ts",
    "src/renderer/src/lib/limitations.ts",
    "src/renderer/src/lib/questions.ts",
    "src/renderer/src/lib/format.ts",
    "src/renderer/src/lib/budget.ts",
    "src/renderer/src/lib/scheduled-surface.ts",
    "src/renderer/src/lib/provider-logos.ts",
    "src/renderer/src/lib/provider-initials.ts",
    "src/renderer/src/lib/memory-selection.ts",
    "scripts/lib/mcp-connectors-test-core.ts",
    "scripts/lib/mcp-connectors-test-report.ts",
    "electron.vite.config.ts",
    "tests/**/*.ts"
  ]
}
